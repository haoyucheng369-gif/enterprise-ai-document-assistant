{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Frontend": {
    "AllowedOrigins": [
      "http://localhost:5173",
      "http://127.0.0.1:5173"
    ]
  },
  "AiGateway": {
    "Provider": "Mock",
    "ChatModel": "mock-document-assistant",
    "EmbeddingModel": "text-embedding-3-small",
    "Endpoint": "https://api.openai.com",
    "ApiKey": "",
    "ApiVersion": "2024-10-21",
    "TimeoutSeconds": 30
  },
  "Rag": {
    "TopK": 4,
    "MinimumSimilarityScore": 0.30
  },
  "MongoDb": {
    "ConnectionString": "mongodb://localhost:27017",
    "DatabaseName": "enterprise_ai_document_assistant",
    "DocumentsCollectionName": "documents"
  },
  "AllowedHosts": "*"
}
